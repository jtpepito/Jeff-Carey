ADMIN_PASSWORD=
# A long random string that signs the admin cookie together with the password. Without it, forged
# cookies can be used to test password guesses. On Fly: fly secrets set SESSION_SECRET=...
SESSION_SECRET=
# DB_PATH=data/store.db

# Email for "ready for pick-up" messages: a Gmail address and an app password
# (Google Account > Security > 2-Step Verification > App passwords). On Fly these are secrets.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=Jef&Carey
